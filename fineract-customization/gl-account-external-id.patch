+package org.apache.fineract.integrationtests.accounting;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.restassured.RestAssured;
+import io.restassured.builder.RequestSpecBuilder;
+import io.restassured.http.ContentType;
+import io.restassured.path.json.JsonPath;
+import io.restassured.response.Response;
+import io.restassured.specification.RequestSpecification;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+import org.apache.fineract.integrationtests.common.Utils;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.RepeatedTest;
+import org.junit.jupiter.api.Test;
+
+/**
+ * End-to-end behaviour of GL account synchronization by external id, against a running Fineract.
+ *
+ * Each test uses its own external id and GL code, so the class can be re-run against a database that is not reset.
+ */
+class GLAccountExternalIdIntegrationTest {
+
+    private static final String GL_ACCOUNTS = "/fineract-provider/api/v1/glaccounts";
+    private static final String TENANT = "default";
+    private static final String ADMIN_PASSWORD = "password";
+    private static final String API_USER_PASSWORD = "Integration#2026";
+
+    private static RequestSpecification admin;
+
+    @BeforeAll
+    static void setUp() {
+        Utils.initializeRESTAssured();
+        admin = as("mifos", ADMIN_PASSWORD);
+    }
+
+    @Test
+    void identicalCreateIsAReplayOfTheSameAccount() {
+        String externalId = uniqueExternalId();
+        Map<String, Object> account = account(externalId, "Loan Receivable");
+
+        Response first = create(admin, account);
+        Response replay = create(admin, account);
+
+        assertEquals(200, first.statusCode());
+        assertEquals(200, replay.statusCode());
+        long id = first.jsonPath().getLong("resourceId");
+        assertEquals(id, replay.jsonPath().getLong("resourceId"));
+        assertEquals(externalId, replay.jsonPath().getString("resourceExternalId"));
+
+        JsonPath stored = findByExternalId(admin, externalId).jsonPath();
+        assertEquals(id, stored.getLong("id"));
+        assertEquals(externalId, stored.getString("externalId"));
+    }
+
+    @Test
+    void sameExternalIdWithADifferentDefinitionIsAConflict() {
+        String externalId = uniqueExternalId();
+        assertEquals(200, create(admin, account(externalId, "Loan Receivable")).statusCode());
+
+        Response conflict = create(admin, account(externalId, "Loans Receivable"));
+
+        assertEquals(409, conflict.statusCode());
+        assertEquals("error.msg.glaccount.external.id.conflict", conflict.jsonPath().getString("userMessageGlobalisationCode"));
+    }
+
+    @RepeatedTest(5)
+    void concurrentIdenticalCreatesResolveToOneAccount() throws Exception {
+        String externalId = uniqueExternalId();
+        Map<String, Object> account = account(externalId, "Interest Income");
+        int requests = 10;
+        CountDownLatch start = new CountDownLatch(1);
+        ExecutorService pool = Executors.newFixedThreadPool(requests);
+        try {
+            Callable<Response> createWhenReleased = () -> {
+                start.await();
+                return create(admin, account);
+            };
+            List<Future<Response>> futures = IntStream.range(0, requests).mapToObj(i -> pool.submit(createWhenReleased)).toList();
+            start.countDown();
+
+            List<Response> responses = futures.stream().map(GLAccountExternalIdIntegrationTest::await).toList();
+
+            assertTrue(responses.stream().allMatch(response -> response.statusCode() == 200),
+                    () -> "statuses: " + responses.stream().map(Response::statusCode).toList());
+            Set<Long> ids = responses.stream().map(response -> response.jsonPath().getLong("resourceId")).collect(Collectors.toSet());
+            assertEquals(1, ids.size(), () -> "distinct account ids: " + ids);
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+
+    @Test
+    void createIsProtectedByFineractPermissions() {
+        long roleId = createRole(List.of("READ_GLACCOUNT"));
+        String username = createUser(roleId);
+        RequestSpecification readOnlyUser = as(username, API_USER_PASSWORD);
+        String externalId = uniqueExternalId();
+
+        Response forbidden = create(readOnlyUser, account(externalId, "Bank"));
+
+        assertEquals(403, forbidden.statusCode());
+        assertEquals("error.msg.not.authorized", forbidden.jsonPath().getString("userMessageGlobalisationCode"));
+        assertEquals(404, findByExternalId(readOnlyUser, externalId).statusCode());
+    }
+
+    @Test
+    void externalIdCannotBeChangedAfterCreate() {
+        String externalId = uniqueExternalId();
+        long id = create(admin, account(externalId, "Bank")).jsonPath().getLong("resourceId");
+
+        // The name is a valid change on its own, so only the external id rule can reject this update.
+        Response update = request(admin).body(Map.of("name", "Bank renamed", "externalId", externalId + "-CHANGED"))
+                .put(GL_ACCOUNTS + "/" + id);
+
+        assertEquals(400, update.statusCode());
+        assertEquals("validation.msg.GLAccount.externalId.cannot.be.updated",
+                update.jsonPath().getString("errors[0].userMessageGlobalisationCode"));
+        JsonPath stored = findByExternalId(admin, externalId).jsonPath();
+        assertEquals(id, stored.getLong("id"));
+        assertEquals("Bank", stored.getString("name"));
+    }
+
+    @Test
+    void anAccountOwnedByAnotherSystemCannotBeChangedOrDeletedInFineract() {
+        String externalId = uniqueExternalId();
+        long id = create(admin, account(externalId, "Bank")).jsonPath().getLong("resourceId");
+
+        Response update = request(admin).body(Map.of("name", "Renamed in Fineract")).put(GL_ACCOUNTS + "/" + id);
+        Response delete = request(admin).delete(GL_ACCOUNTS + "/" + id);
+
+        assertEquals(409, update.statusCode());
+        assertEquals("error.msg.glaccount.externally.owned", update.jsonPath().getString("userMessageGlobalisationCode"));
+        assertEquals(409, delete.statusCode());
+        assertEquals("Bank", findByExternalId(admin, externalId).jsonPath().getString("name"));
+    }
+
+    @Test
+    void unknownExternalIdIsNotFound() {
+        assertEquals(404, findByExternalId(admin, uniqueExternalId()).statusCode());
+    }
+
+    private static Map<String, Object> account(final String externalId, final String name) {
+        return Map.of("name", name, "glCode", externalId.substring(3), "type", 1, "usage", 1, "manualEntriesAllowed", true, "description",
+                "Synchronized from ERP", "externalId", externalId);
+    }
+
+    private static Response create(final RequestSpecification user, final Map<String, Object> account) {
+        return request(user).body(account).post(GL_ACCOUNTS);
+    }
+
+    private static Response findByExternalId(final RequestSpecification user, final String externalId) {
+        return request(user).get(GL_ACCOUNTS + "/external-id/" + externalId);
+    }
+
+    private static long createRole(final List<String> permissions) {
+        long roleId = request(admin)
+                .body(Map.of("name", Utils.uniqueRandomStringGenerator("GL_READER_", 6), "description", "Can read GL accounts only"))
+                .post("/fineract-provider/api/v1/roles").jsonPath().getLong("resourceId");
+        Map<String, Boolean> grants = permissions.stream().collect(Collectors.toMap(code -> code, code -> true));
+        Response granted = request(admin).body(Map.of("permissions", grants))
+                .put("/fineract-provider/api/v1/roles/" + roleId + "/permissions");
+        assertEquals(200, granted.statusCode(), granted::asString);
+        return roleId;
+    }
+
+    private static String createUser(final long roleId) {
+        String username = Utils.uniqueRandomStringGenerator("gl_reader_", 6);
+        Response created = request(admin).body(Map.of("username", username, "firstname", "GL", "lastname", "Reader", "email",
+                "gl.reader@example.com", "officeId", 1, "roles", List.of(roleId), "sendPasswordToEmail", false, "password",
+                API_USER_PASSWORD, "repeatPassword", API_USER_PASSWORD, "passwordNeverExpires", true))
+                .post("/fineract-provider/api/v1/users");
+        assertEquals(200, created.statusCode(), created::asString);
+        return username;
+    }
+
+    private static RequestSpecification as(final String username, final String password) {
+        return new RequestSpecBuilder().setContentType(ContentType.JSON).addHeader("Fineract-Platform-TenantId", TENANT).build().auth()
+                .preemptive().basic(username, password);
+    }
+
+    /**
+     * RestAssured specifications are mutable: every request starts from a fresh copy, so parallel calls never share
+     * state.
+     */
+    private static RequestSpecification request(final RequestSpecification user) {
+        return RestAssured.given().spec(user);
+    }
+
+    private static String uniqueExternalId() {
+        return "GL-IT-" + Utils.uniqueRandomStringGenerator("", 8);
+    }
+
+    private static Response await(final Future<Response> future) {
+        try {
+            return future.get();
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+}
