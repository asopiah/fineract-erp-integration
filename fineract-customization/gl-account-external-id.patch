+package org.apache.fineract.accounting.glaccount.exception;
+
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import jakarta.ws.rs.core.Response.Status;
+import jakarta.ws.rs.ext.ExceptionMapper;
+import jakarta.ws.rs.ext.Provider;
+import java.util.List;
+import lombok.extern.slf4j.Slf4j;
+import org.apache.fineract.infrastructure.core.data.ApiGlobalErrorResponse;
+import org.apache.fineract.infrastructure.core.data.ApiParameterError;
+import org.apache.fineract.infrastructure.core.exceptionmapper.FineractExceptionMapper;
+import org.springframework.context.annotation.Scope;
+import org.springframework.stereotype.Component;
+
+/**
+ * Answers {@link GLAccountExternalIdConflictException} with 409 instead of the 403 used for other domain-rule
+ * violations, which callers would confuse with a missing permission.
+ */
+@Provider
+@Component
+@Scope("singleton")
+@Slf4j
+public class GLAccountExternalIdConflictExceptionMapper
+        implements FineractExceptionMapper, ExceptionMapper<GLAccountExternalIdConflictException> {
+
+    @Override
+    public Response toResponse(final GLAccountExternalIdConflictException exception) {
+        log.warn("GL account external id conflict: {}", exception.getDefaultUserMessage());
+        final ApiParameterError error = ApiParameterError.generalError(exception.getGlobalisationMessageCode(),
+                exception.getDefaultUserMessage(), exception.getDefaultUserMessageArgs());
+        final ApiGlobalErrorResponse body = ApiGlobalErrorResponse.create(Status.CONFLICT.getStatusCode(),
+                exception.getGlobalisationMessageCode(), exception.getDefaultUserMessage(), exception.getDefaultUserMessage(),
+                List.of(error));
+        return Response.status(Status.CONFLICT).entity(body).type(MediaType.APPLICATION_JSON).build();
+    }
+
+    @Override
+    public int errorCode() {
+        return 4091;
+    }
+}
