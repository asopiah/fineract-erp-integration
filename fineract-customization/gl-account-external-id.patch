+package org.apache.fineract.accounting.glaccount.exception;
+
+import org.apache.fineract.infrastructure.core.domain.ExternalId;
+import org.apache.fineract.infrastructure.core.exception.AbstractPlatformDomainRuleException;
+
+/**
+ * Thrown when a GL account create reuses an external id that already identifies a GL account with a different
+ * definition. Mapped to HTTP 409 by {@link GLAccountExternalIdConflictExceptionMapper}.
+ */
+public class GLAccountExternalIdConflictException extends AbstractPlatformDomainRuleException {
+
+    public GLAccountExternalIdConflictException(final ExternalId externalId) {
+        this("error.msg.glaccount.external.id.conflict",
+                "General Ledger Account with external id " + externalId.getValue() + " already exists with a different definition",
+                externalId);
+    }
+
+    protected GLAccountExternalIdConflictException(final String code, final String message, final ExternalId externalId) {
+        super(code, message, externalId.getValue());
+    }
+}
