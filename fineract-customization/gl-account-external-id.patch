+package org.apache.fineract.accounting.glaccount.service;
+
+import java.sql.SQLException;
+
+/**
+ * Recognizes a unique-constraint violation by its SQL state, independent of the database's constraint naming.
+ */
+final class UniqueConstraintViolations {
+
+    private static final String SQL_STATE_UNIQUE_VIOLATION = "23505"; // PostgreSQL
+    private static final String SQL_STATE_INTEGRITY_CONSTRAINT_VIOLATION = "23000"; // MySQL, MariaDB
+    private static final int MYSQL_DUPLICATE_ENTRY = 1062;
+
+    private UniqueConstraintViolations() {}
+
+    static boolean isCausedBy(final Throwable throwable) {
+        for (Throwable cause = throwable; cause != null; cause = cause.getCause()) {
+            if (cause instanceof SQLException sqlException && isUniqueViolation(sqlException)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean isUniqueViolation(final SQLException exception) {
+        return SQL_STATE_UNIQUE_VIOLATION.equals(exception.getSQLState())
+                || (SQL_STATE_INTEGRITY_CONSTRAINT_VIOLATION.equals(exception.getSQLState())
+                        && exception.getErrorCode() == MYSQL_DUPLICATE_ENTRY);
+    }
+}
