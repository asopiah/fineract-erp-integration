+package org.apache.fineract.accounting.glaccount.domain;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.apache.fineract.infrastructure.codes.domain.CodeValue;
+import org.apache.fineract.infrastructure.core.domain.ExternalId;
+import org.junit.jupiter.api.Test;
+
+class GLAccountDefinitionTest {
+
+    @Test
+    void sameCallerSuppliedAttributesAreTheSameDefinition() {
+        assertTrue(loanReceivable().hasSameDefinitionAs(loanReceivable()));
+    }
+
+    @Test
+    void fineractOwnedStateIsNotPartOfTheDefinition() {
+        GLAccount stored = loanReceivable().setDisabled(true).setHierarchy(".7.");
+        stored.setId(7L);
+
+        assertTrue(stored.hasSameDefinitionAs(loanReceivable()));
+    }
+
+    @Test
+    void anyCallerSuppliedDifferenceIsADifferentDefinition() {
+        GLAccount stored = loanReceivable();
+
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setName("Loans Receivable")));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setGlCode("1201")));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setType(GLAccountType.LIABILITY.getValue())));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setUsage(GLAccountUsage.HEADER.getValue())));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setManualEntriesAllowed(false)));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setDescription("Other")));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setParent(parent(3L))));
+        assertFalse(stored.hasSameDefinitionAs(loanReceivable().setTagId(tag(4L))));
+    }
+
+    private static GLAccount loanReceivable() {
+        return new GLAccount().setGlCode("1200").setName("Loan Receivable").setType(GLAccountType.ASSET.getValue())
+                .setUsage(GLAccountUsage.DETAIL.getValue()).setManualEntriesAllowed(true).setDescription("ERP account")
+                .setExternalId(new ExternalId("GL-1200"));
+    }
+
+    private static CodeValue tag(final long id) {
+        CodeValue tag = new CodeValue();
+        tag.setId(id);
+        return tag;
+    }
+
+    private static GLAccount parent(final long id) {
+        GLAccount parent = new GLAccount();
+        parent.setId(id);
+        return parent;
+    }
+}
