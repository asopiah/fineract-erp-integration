+package org.apache.fineract.accounting.glaccount.exception;
+
+import org.apache.fineract.infrastructure.core.domain.ExternalId;
+import org.springframework.dao.ConcurrencyFailureException;
+
+/**
+ * A create carrying an external id lost a unique-constraint race to a concurrent request.
+ *
+ * The losing transaction can no longer read the winner, so this extends {@link ConcurrencyFailureException}: Fineract's
+ * command retry ({@code fineract.retry.instances.executeCommand}) re-runs the request in a fresh transaction, where it
+ * resolves to the winner as a replay or a conflict.
+ */
+public class GLAccountExternalIdRaceException extends ConcurrencyFailureException {
+
+    public GLAccountExternalIdRaceException(final ExternalId externalId, final Throwable cause) {
+        super("Concurrent create of General Ledger Account with external id " + externalId.getValue(), cause);
+    }
+}
